# Copy to .env and fill in. Never commit .env.

# Postgres and Redis (docker-compose defaults for local dev)
DATABASE_URL=postgresql://rationale:rationale@localhost:5432/rationale
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Host the web app is served from; Sign-In with Ethereum messages must name it.
APP_ORIGIN=http://localhost:3000
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Web: where Next.js forwards /api/* requests
API_INTERNAL_URL=http://127.0.0.1:4000

# LLM for sentence-to-plan intake (Anthropic). Leave empty to disable intake.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Intake stops for the month once estimated spend reaches this many USD.
LLM_MONTHLY_BUDGET_USD=20

# Engine
# Minute past each hour when agents run (candles close on the hour).
ENGINE_RUN_MINUTE=1

# Tests that touch the database use this one (it is wiped by the tests).
TEST_DATABASE_URL=postgresql://rationale:rationale@localhost:5432/rationale_test

# Optional alerts from scripts/healthcheck.sh (sent when health changes state).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading on Robinhood Chain. Leave all of these empty for paper trading only.
# The vault factory deployed on mainnet (docs/phase3.md). Setting it turns the Vault screens on.
LIVE_FACTORY_ADDRESS=
# The agent's signing key (engine only). It can swap inside users' vaults within their limits; it can never
# withdraw. Create it on the server with `node scripts/keys.mjs create operator`. Never commit it or paste it
# anywhere. The API and the website never read it.
OPERATOR_PRIVATE_KEY=
# Set to 1 to pause live trading: no live agent starts or trades, and everyone can still see and empty their vault.
LIVE_TRADING_PAUSED=
# Optional: another RPC endpoint for Robinhood Chain.
LIVE_RPC_URL=
# While the contracts are unaudited: the most a vault may hold when a live agent is launched, in dollars.
LIVE_MAX_VAULT_USD=500
