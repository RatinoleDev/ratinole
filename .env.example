# Copy to .env and fill in. Never commit .env.

# Postgres and Redis (docker-compose defaults for local dev)
DATABASE_URL=postgresql://rationale:rationale@localhost:5432/rationale
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Host the web app is served from; Sign-In with Ethereum messages must name it.
APP_ORIGIN=http://localhost:3000
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Web: where Next.js forwards /api/* requests
API_INTERNAL_URL=http://127.0.0.1:4000

# LLM for sentence-to-plan intake (Anthropic). Leave empty to disable intake.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Intake stops for the month once estimated spend reaches this many USD.
LLM_MONTHLY_BUDGET_USD=20

# Engine
# Minute past each hour when agents run (candles close on the hour).
ENGINE_RUN_MINUTE=1

# Tests that touch the database use this one (it is wiped by the tests).
TEST_DATABASE_URL=postgresql://rationale:rationale@localhost:5432/rationale_test
