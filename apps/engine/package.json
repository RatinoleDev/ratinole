{
  "name": "@rationale/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "tick": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@rationale/brain": "workspace:*",
    "@rationale/config": "workspace:*",
    "@rationale/db": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
