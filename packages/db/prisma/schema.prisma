// Every number shown to a user is read from these tables (HANDOFF section 8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  /// Lower-case 0x address.
  address         String    @unique
  /// Cap on size per trade, percent of cash.
  maxSizePct      Float     @default(35)
  dailyLossCapPct Float     @default(3)
  createdAt       DateTime  @default(now())
  sessions        Session[]
  agents          Agent[]
  backtests       Backtest[]
  memeAgents      MemeAgent[]
}

model Session {
  /// Random 32-byte hex id, stored in a signed httpOnly cookie.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Agent {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  sentence     String
  /// The confirmed Plan (packages/brain types.ts).
  plan         Json
  /// Settings chosen by the backtest tuner (AgentParams).
  params       Json
  market       String
  /// "paper" (virtual money) or "live" (real money in the owner's vault).
  mode         String      @default("paper")
  /// Live agents only: the owner's vault on Robinhood Chain, lower-case 0x address.
  vault        String?
  /// "active" | "paused" | "archived" (deleted by the owner; decisions are kept)
  status       String      @default("active")
  /// Set when the engine paused a live agent itself (vault emptied, access revoked, new owner), in plain words.
  pausedReason String?
  /// Run by the Ratinole team to show live decisions; labelled "House" everywhere.
  house        Boolean     @default(false)
  archivedAt   DateTime?
  /// Paper: virtual cash at launch. Live: the vault's value at launch, then adjusted on every deposit and
  /// withdrawal the way a fund issues and redeems units, so moving money in or out never counts as a gain or a
  /// loss. Return is always equity / startingCash - 1.
  startingCash Float
  /// Wallet limits copied at launch so later changes do not rewrite history.
  maxSizePct      Float
  dailyLossCapPct Float
  backtestId   String?
  backtest     Backtest?   @relation(fields: [backtestId], references: [id], onDelete: SetNull)
  launchedAt   DateTime    @default(now())
  /// First hour boundary the engine owes a decision for since launch or the
  /// last resume. Hours while paused are not owed and never backfilled.
  owedFrom     DateTime
  /// Price used for the holding benchmark (first fill price), set by the first decision.
  holdEntryPrice Float?
  createdAt    DateTime    @default(now())
  state        AgentState?
  decisions    Decision[]
  orders       LiveOrder[]

  @@index([userId])
  @@index([status])
}

/// Paper position after the latest decision.
model AgentState {
  agentId        String    @id
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  cash           Float
  qty            Float
  avgEntry       Float?
  peak           Float?
  /// Open time of the newest candle whose close the trailing-stop high has taken in. Null when flat.
  peakSeenTo     DateTime?
  /// An exit that was reached and whose sale did not complete: the hour it was first reached, and which exit
  /// ("take profit" | "stop loss" | "trailing stop" | "exit rule"). While set, the agent sells in every hour it can.
  exitPendingSince DateTime?
  exitPendingKind  String?
  lastBuyAt      DateTime?
  dayStart       DateTime
  dayStartEquity Float
  /// Running stats over all stored decisions, so rankings need not scan them.
  decisions         Int       @default(0)
  lastHour          DateTime?
  lastEquity        Float?
  lastHoldingEquity Float?
  peakEquity        Float?
  maxDrawdownPct    Float     @default(0)
  updatedAt      DateTime  @updatedAt
}

model Decision {
  id                 String   @id @default(cuid())
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// The hour boundary this decision is for.
  hour               DateTime
  action             String
  confidence         Int
  regime             String
  evidence           Json
  guard              Json
  explanation        String
  /// Live agents only: the on-chain transaction of this hour's order.
  txHash             String?
  /// Live agents only: why this hour's order did not go through. Null when it did, or when there was none.
  execError          String?
  /// Live agents only: dollars the owner moved into (+) or out of (-) the vault since the previous decision.
  flowUsd            Float?
  /// Live agents only: the agent's startingCash after this hour (it moves with deposits and withdrawals), so
  /// a chart of past hours divides each equity by the base it had at the time.
  basisAfter         Float?
  /// Made after the fact by catch-up rather than on time.
  late               Boolean  @default(false)
  fillSide           String?
  fillPrice          Float?
  fillQty            Float?
  fillNotional       Float?
  fillFee            Float?
  cashAfter          Float
  qtyAfter           Float
  equityAfter        Float
  holdingEquityAfter Float
  markPrice          Float
  /// e.g. "binance:ETHUSDT"
  candleSource       String
  /// Open time of the last closed candle used.
  candleTime         DateTime
  createdAt          DateTime @default(now())

  @@unique([agentId, hour])
  @@index([hour])
}

/// One on-chain order per live agent per hour. The row is written before the order is sent, so a crash or a
/// retry can never send the same order twice.
model LiveOrder {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  hour      DateTime
  /// "buy" | "sell"
  side      String
  vault     String
  tokenIn   String
  tokenOut  String
  /// Raw token units, as a decimal string.
  amountIn  String
  /// "pending" (recorded, maybe sent) | "done" | "failed"
  status    String   @default("pending")
  /// Chain height when the order was recorded; where to look for it after a crash.
  fromBlock String
  txHash    String?
  amountOut String?
  /// The block the order landed in. A later read of the vault waits for a connection that has seen this block.
  minedBlock String?
  error     String?
  /// Why the order was smaller than the plan asked for, as a sentence for the explanation. Kept with the order so
  /// that a run which books it later still says so.
  note      String?
  /// For a sale: which exit asked for it ("take profit" | "stop loss" | "trailing stop" | "exit rule"), so that a
  /// run which books it later knows whether the rest of a sale cut short is still to be sold.
  exitKind  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, hour])
  @@index([status])
}

model Backtest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// "user" | "example"
  kind        String   @default("user")
  sentence    String
  plan        Json
  market      String
  /// "queued" | "running" | "done" | "failed"
  status      String   @default("queued")
  error       String?
  source      String?
  label       String   @default("Price signals only")
  /// Wallet limits used for the run.
  maxSizePct      Float
  dailyLossCapPct Float
  costPct     Float
  startCash   Float
  params      Json?
  fromTime    DateTime?
  splitTime   DateTime?
  toTime      DateTime?
  candles     Int?
  tunedReturnPct   Float?
  unseenReturnPct  Float?
  holdingTunedPct  Float?
  holdingUnseenPct Float?
  maxDrawdownPct   Float?
  tunedTrades Int?
  unseenTrades Int?
  /// Downsampled equity curve [{t, strategy, holding}], 100 = start.
  curve       Json?
  /// Full walk-forward output for audit.
  detail      Json?
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  agents      Agent[]

  @@index([kind, status, createdAt])
  @@index([userId])
}

/// Closed hourly candles, cached so decisions and backtests can be reproduced.
model Candle {
  market   String
  source   String
  openTime DateTime
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float
  fetchedAt DateTime @default(now())

  @@id([market, source, openTime])
}

model EngineRun {
  id         String    @id @default(cuid())
  hour       DateTime
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  agents     Int       @default(0)
  decisions  Int       @default(0)
  late       Int       @default(0)
  errors     Int       @default(0)
  detail     Json?

  @@index([hour])
}

model LlmUsage {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  userId       String?
  model        String
  purpose      String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  ok           Boolean

  @@index([at])
}

/// Hourly perpetual funding rates, saved so decisions and backtests can be replayed.
model FundingRate {
  market    String
  source    String
  /// Settlement time, floored to the hour.
  hour      DateTime
  /// Fraction per hour (0.0000125 = 0.01% per 8 hours).
  rate      Float
  fetchedAt DateTime @default(now())

  @@id([market, source, hour])
}

/// The market as the engine read it at an hour: shown on the landing page.
model MarketSnapshot {
  market       String
  /// Hour boundary the reading belongs to (close of the last candle used).
  hour         DateTime
  price        Float
  change24Pct  Float
  regime       String
  direction    String
  reason       String
  rsi          Float?
  /// Percent per 8 hours, 8-hour average; null when funding was unavailable.
  funding8hPct Float?
  dailyVolPct  Float
  /// Hourly closes for the last 7 days, oldest first.
  closes7d     Json
  candleSource String
  fundingSource String?
  createdAt    DateTime @default(now())

  @@id([market, hour])
  @@index([hour])
}

/// A meme agent: buy one launchpad token with a set amount of ETH from the owner's meme vault, then sell it all
/// when it is up by the take profit or down by the stop loss. Amounts are wei or raw token units, as decimal
/// strings, and come from the vault's own events.
model MemeAgent {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  /// Lower-case 0x addresses.
  vault         String
  token         String
  /// As the token contract answered when the agent was launched. Names and tickers are not unique; `token` is.
  symbol        String
  tokenName     String
  decimals      Int
  /// ETH to buy with.
  buyWei        String
  /// Percent, measured from what selling everything would have returned right after the buy. Null = no such exit.
  takeProfitPct Float?
  stopLossPct   Float?
  /// "active" | "paused" | "done" | "archived" (deleted by the owner; its events are kept)
  status        String      @default("active")
  /// "buying" | "holding" | "selling" | "sold" | "stopped"
  stage         String      @default("buying")
  /// Why the engine stopped it, or the owner paused it, in plain words.
  pausedReason  String?
  spentWei      String      @default("0")
  tokensRaw     String      @default("0")
  receivedWei   String      @default("0")
  /// What selling everything would have returned right after the buy: the base both exits are measured from.
  entryValueWei String?
  /// The last look: what selling everything would return, or why that could not be worked out.
  lastValueWei  String?
  lastCheckedAt DateTime?
  lastCheckNote String?
  /// Buys the market refused in a row. Reset by a fill or by the owner resuming.
  buyTries      Int         @default(0)
  /// Set when the owner asked for the position to be sold now.
  sellRequested Boolean     @default(false)
  /// "take profit" | "stop loss" | "sold by owner"
  exitKind      String?
  launchedAt    DateTime    @default(now())
  closedAt      DateTime?
  archivedAt    DateTime?
  updatedAt     DateTime    @updatedAt
  orders        MemeOrder[]
  events        MemeEvent[]

  @@index([userId])
  @@index([status])
  @@index([vault, token])
}

/// One on-chain order of a meme agent. The row is written, with the order's hash, before the order is sent, so a
/// crash or a retry can never send it twice and it can always be found again.
model MemeOrder {
  id         String    @id @default(cuid())
  agentId    String
  agent      MemeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// "buy" | "sell"
  side       String
  /// Wei for a buy, raw token units for a sale.
  amountIn   String
  /// "pending" (signed, maybe sent) | "done" | "failed"
  status     String    @default("pending")
  txHash     String?   @unique
  /// Unix seconds after which the vault refuses this order.
  deadline   Int
  /// What the vault's own event says the order did.
  ethWei     String?
  tokensRaw  String?
  minedBlock String?
  error      String?
  /// For a sale: which exit asked for it.
  exitKind   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agentId, status])
}

/// What a meme agent did and why, in the order it happened. Every number in `text` is also in `detail`.
model MemeEvent {
  id        String    @id @default(cuid())
  agentId   String
  agent     MemeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  at        DateTime  @default(now())
  /// "bought" | "sold" | "not bought" | "not sold" | "stopped" | "note"
  kind      String
  text      String
  txHash    String?
  detail    Json?

  @@index([agentId, at])
}
