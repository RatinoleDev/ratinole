{
  "name": "@rationale/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "migrate:dev": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "typecheck": "tsc -p tsconfig.json",
    "studio": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
